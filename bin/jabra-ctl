#!/usr/bin/python3
"""Jabra Link helper for the Omarchy bar plugin.

Talks to a Jabra Link 390 USB dongle through sysfs, PipeWire/Pulse,
and the HID input node. Vendor HID (battery, and a desktop ANC probe)
needs hidraw access; without it the panel still shows the tap
cheatsheet and volume/mute.
"""
from __future__ import annotations

import json
import os
import select
import sys
import time
from pathlib import Path

VENDOR = "0b0e"
JABRA_HINTS = ("jabra", "gn netcom", "link 390", "link 380")

# GN Protocol over HID report 5. Same layout fwupd uses for Jabra GNP
# battery: 64-byte output/input, child headset at address 0x04.
GNP_REPORT = 0x05
GNP_CMD_BATTERY = 0x12
GNP_SUB_BATTERY = 0x02
GNP_ADDRS = (0x04, 0x01, 0x08)
GNP_PACKET = 64


def _now() -> float:
  return time.time()


def _run(cmd: list[str], timeout: float = 2.5) -> tuple[int, str, str]:
  import subprocess
  try:
    proc = subprocess.run(
      cmd, check=False, capture_output=True, text=True, timeout=timeout
    )
  except (OSError, subprocess.TimeoutExpired) as err:
    return 1, "", str(err)
  return proc.returncode, proc.stdout or "", proc.stderr or ""


def _pactl_json(kind: str) -> list:
  code, out, _err = _run(["pactl", "-f", "json", "list", kind])
  if code != 0 or not out.strip():
    return []
  try:
    data = json.loads(out)
  except json.JSONDecodeError:
    return []
  return data if isinstance(data, list) else []


def _is_jabra_text(*parts: str) -> bool:
  blob = " ".join(parts).lower()
  return any(hint in blob for hint in JABRA_HINTS)


def _volume_of(node: dict) -> float:
  vol = node.get("volume") or {}
  percents = []
  for _ch, info in vol.items():
    if not isinstance(info, dict):
      continue
    raw = str(info.get("value_percent") or "").strip().rstrip("%")
    try:
      percents.append(float(raw) / 100.0)
    except ValueError:
      continue
  if not percents:
    return 0.0
  return max(0.0, min(1.0, sum(percents) / len(percents)))


def scan_usb() -> dict:
  """Find a GN Netcom / Jabra USB audio+HID device in sysfs."""
  base = Path("/sys/bus/usb/devices")
  if not base.is_dir():
    return {}
  for dev in base.iterdir():
    vid = _read_text(dev / "idVendor")
    if vid != VENDOR:
      continue
    product = _read_text(dev / "product") or "Jabra"
    serial = _read_text(dev / "serial")
    pid = _read_text(dev / "idProduct")
    return {
      "connected": True,
      "name": product.strip() or "Jabra",
      "productId": pid,
      "serial": serial,
      "sysfs": str(dev),
    }
  return {}


def _read_text(path: Path) -> str:
  try:
    return path.read_text(encoding="utf-8", errors="replace").strip()
  except OSError:
    return ""


def hidraw_status() -> dict:
  """Whether we can open the Jabra vendor HID node."""
  hidraw = Path("/sys/class/hidraw")
  if not hidraw.is_dir():
    return {"hidAccess": "missing", "hidraw": ""}
  for node in sorted(hidraw.glob("hidraw*")):
    uevent = _read_text(node / "device" / "uevent")
    if "00000B0E:" not in uevent.upper() and "JABRA" not in uevent.upper():
      continue
    dev = Path("/dev") / node.name
    info = {"hidraw": str(dev), "hidAccess": "denied"}
    try:
      fd = os.open(dev, os.O_RDWR | os.O_NONBLOCK)
    except OSError:
      return info
    os.close(fd)
    info["hidAccess"] = "ok"
    return info
  return {"hidAccess": "missing", "hidraw": ""}


def gnp_battery_request(dst: int, seq: int) -> bytes:
  pkt = bytearray(GNP_PACKET)
  pkt[0] = GNP_REPORT
  pkt[1] = dst & 0xFF
  pkt[2] = 0x00
  pkt[3] = seq & 0xFF
  pkt[4] = 0x46
  pkt[5] = GNP_CMD_BATTERY
  pkt[6] = GNP_SUB_BATTERY
  return bytes(pkt)


def parse_gnp_battery(buf: bytes | bytearray) -> dict | None:
  """Decode a GNP battery input report. Returns None if this is not one."""
  if not buf:
    return None
  data = bytes(buf)
  if data[0] != GNP_REPORT:
    return None
  if len(data) < 9:
    return None
  if data[5] != GNP_CMD_BATTERY or data[6] != GNP_SUB_BATTERY:
    return None
  percent = int(data[8])
  if percent < 1 or percent > 100:
    return None
  charging = False
  low = percent <= 15
  if len(data) > 9 and data[9] in (0, 1):
    charging = bool(data[9])
  if len(data) > 10 and data[10] in (0, 1):
    low = bool(data[10])
  return {"percent": percent, "charging": charging, "low": low}


def query_battery(hid_path: str, dsts: tuple[int, ...] = GNP_ADDRS) -> dict | None:
  """One-shot GNP battery read. Needs hidraw write permission."""
  try:
    fd = os.open(hid_path, os.O_RDWR | os.O_NONBLOCK)
  except OSError:
    return None
  try:
    seq = int(time.time()) & 0xFF
    for dst in dsts:
      try:
        os.write(fd, gnp_battery_request(dst, seq))
      except OSError:
        return None
      seq = (seq + 1) & 0xFF
      deadline = _now() + 0.4
      while _now() < deadline:
        ready, _w, _x = select.select([fd], [], [], max(0.0, deadline - _now()))
        if not ready:
          continue
        try:
          buf = os.read(fd, GNP_PACKET)
        except OSError:
          break
        parsed = parse_gnp_battery(buf)
        if parsed:
          parsed["address"] = dst
          return parsed
    return None
  finally:
    os.close(fd)


def pulse_status() -> dict:
  sinks = _pactl_json("sinks")
  sources = _pactl_json("sources")
  code, default_sink, _ = _run(["pactl", "get-default-sink"])
  default_sink = default_sink.strip() if code == 0 else ""
  code, default_source, _ = _run(["pactl", "get-default-source"])
  default_source = default_source.strip() if code == 0 else ""

  sink = next((s for s in sinks if _is_jabra_text(s.get("name", ""), s.get("description", "")) and "monitor" not in str(s.get("name", "")).lower()), None)
  source = next((s for s in sources if _is_jabra_text(s.get("name", ""), s.get("description", "")) and "monitor" not in str(s.get("name", "")).lower()), None)

  out = {
    "sinkName": "",
    "sinkDescription": "",
    "sourceName": "",
    "defaultSink": False,
    "volume": 0.0,
    "muted": False,
    "micMuted": False,
    "audio": False,
  }
  if sink:
    name = str(sink.get("name") or "")
    out["sinkName"] = name
    out["sinkDescription"] = str(sink.get("description") or "")
    out["defaultSink"] = name == default_sink
    out["volume"] = _volume_of(sink)
    out["muted"] = bool(sink.get("mute"))
    out["audio"] = True
  if source:
    out["sourceName"] = str(source.get("name") or "")
    out["micMuted"] = bool(source.get("mute"))
  return out


def boost_jabra_capture() -> None:
  """USB Mic was at 0/5 (-9 dB). Dictation needs the hardware capture open."""
  _run(["amixer", "-q", "-c", "J390", "sset", "Mic", "5", "unmute"])


def find_hotkey_devices() -> list:
  """Keyboards that can start Voxtype (RIGHTCTRL / F9). Do not grab."""
  try:
    from evdev import InputDevice, list_devices, ecodes
  except ImportError:
    return []
  found = []
  want = {ecodes.KEY_RIGHTCTRL, ecodes.KEY_F9}
  for path in list_devices():
    try:
      dev = InputDevice(path)
    except OSError:
      continue
    keys = set(dev.capabilities().get(ecodes.EV_KEY, []))
    if want & keys and not _is_jabra_text(dev.name or ""):
      found.append(dev)
  return found


def find_evdev() -> str:
  try:
    from evdev import InputDevice, list_devices
  except ImportError:
    return ""
  for path in list_devices():
    try:
      dev = InputDevice(path)
    except OSError:
      continue
    if _is_jabra_text(dev.name or ""):
      return path
  return ""


KEY_LABELS = {
  "KEY_PLAYPAUSE": "Play / pause",
  "KEY_PLAY": "Play",
  "KEY_PAUSE": "Pause",
  "KEY_NEXTSONG": "Next track",
  "KEY_PREVIOUSSONG": "Previous track",
  "KEY_STOPCD": "Stop",
  "KEY_VOLUMEUP": "Volume up",
  "KEY_VOLUMEDOWN": "Volume down",
  "KEY_MUTE": "Mute",
  "KEY_MICMUTE": "Mute microphone",
}


def key_label(code: str) -> str:
  return KEY_LABELS.get(code, code.replace("KEY_", "").replace("_", " ").title())


def snapshot(
  last_gesture: dict | None = None,
  last_battery: dict | None = None,
  probe_battery: bool = False,
) -> dict:
  usb = scan_usb()
  pulse = pulse_status()
  hid = hidraw_status()
  connected = bool(usb) or bool(pulse.get("audio"))
  name = usb.get("name") or pulse.get("sinkDescription") or "Jabra"
  if " " in name:
    name = name.strip()
  battery = last_battery
  if probe_battery and hid.get("hidAccess") == "ok" and hid.get("hidraw"):
    probed = query_battery(str(hid["hidraw"]))
    if probed:
      battery = probed
  return {
    "ok": True,
    "connected": connected,
    "name": name,
    "headset": "Evolve2 Buds",
    "dongle": usb.get("name") or ("Jabra Link 390" if connected else ""),
    "serial": usb.get("serial") or "",
    "productId": usb.get("productId") or "",
    "hidAccess": hid.get("hidAccess") or "missing",
    "hidraw": hid.get("hidraw") or "",
    "sinkName": pulse.get("sinkName") or "",
    "sourceName": pulse.get("sourceName") or "",
    "defaultSink": bool(pulse.get("defaultSink")),
    "volume": pulse.get("volume") or 0.0,
    "muted": bool(pulse.get("muted")),
    "micMuted": bool(pulse.get("micMuted")),
    "battery": battery,
    "anc": None,
    "ancControl": False,
    "lastGesture": last_gesture,
    "error": "" if connected else "No Jabra USB device",
  }


def emit(data: dict) -> None:
  sys.stdout.write(json.dumps(data, separators=(",", ":")) + "\n")
  sys.stdout.flush()


def cmd_status() -> int:
  emit(snapshot(probe_battery=True))
  return 0


def _need_sink(data: dict) -> str:
  name = data.get("sinkName") or ""
  if not name:
    emit({"ok": False, "error": "Jabra is not an audio sink right now"})
    return ""
  return name


def cmd_set_default() -> int:
  data = snapshot()
  name = _need_sink(data)
  if not name:
    return 1
  code, _out, err = _run(["pactl", "set-default-sink", name])
  if code != 0:
    emit({"ok": False, "error": err.strip() or "Could not set default output"})
    return 1
  emit(snapshot())
  return 0


def cmd_mute(kind: str) -> int:
  data = snapshot()
  if kind == "mic":
    name = data.get("sourceName") or ""
    if not name:
      emit({"ok": False, "error": "Jabra microphone is not available"})
      return 1
    code, _out, err = _run(["pactl", "set-source-mute", name, "toggle"])
  else:
    name = _need_sink(data)
    if not name:
      return 1
    code, _out, err = _run(["pactl", "set-sink-mute", name, "toggle"])
  if code != 0:
    emit({"ok": False, "error": err.strip() or "Mute failed"})
    return 1
  emit(snapshot())
  return 0


def cmd_volume(delta: str) -> int:
  data = snapshot()
  name = _need_sink(data)
  if not name:
    return 1
  if delta in ("up", "+"):
    arg = "+5%"
  elif delta in ("down", "-"):
    arg = "-5%"
  else:
    try:
      pct = int(round(float(delta) * 100)) if "." in delta else int(delta)
    except ValueError:
      emit({"ok": False, "error": "Volume must be up, down, or a percent"})
      return 1
    pct = max(0, min(150, pct))
    arg = f"{pct}%"
  code, _out, err = _run(["pactl", "set-sink-volume", name, arg])
  if code != 0:
    emit({"ok": False, "error": err.strip() or "Volume failed"})
    return 1
  emit(snapshot())
  return 0


def cmd_anc(_mode: str) -> int:
  hid = hidraw_status()
  if hid.get("hidAccess") != "ok":
    emit({
      "ok": False,
      "error": "hid-permission",
      "detail": "The buds cycle ANC from the left button. Desktop control needs hidraw access.",
      "hidAccess": hid.get("hidAccess"),
    })
    return 2
  emit({
    "ok": False,
    "error": "not-supported",
    "detail": "These buds cycle ANC on the left button. The USB dongle does not expose a desktop ANC switch.",
    "hidAccess": "ok",
  })
  return 1


# HID report 2: telephony LED bits. Bit 0 is Off-Hook, bit 1 is Mute.
# Linux never implements the host side, so opening the dongle mic looks
# like a call with no unmute — the buds say "muted" and send silence.
TELEPHONY_REPORT = 0x02
TELEPHONY_OFFHOOK = 1 << 0
TELEPHONY_MUTE = 1 << 1


def telephony_report(off_hook: bool, muted: bool = False) -> bytes:
  bits = 0
  if off_hook:
    bits |= TELEPHONY_OFFHOOK
  if muted:
    bits |= TELEPHONY_MUTE
  # Report ID + two data bytes. Jabra WebHID sendReport(0x02, [bits, 0]).
  return bytes((TELEPHONY_REPORT, bits, 0))


def voxtype_recording() -> bool:
  runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
  try:
    text = Path(runtime, "voxtype", "state").read_text(encoding="utf-8", errors="replace")
  except OSError:
    return False
  return text.strip().lower() == "recording"


def jabra_capture_active(source_name: str) -> bool:
  if not source_name:
    return False
  sources = _pactl_json("sources")
  index = next((s.get("index") for s in sources if s.get("name") == source_name), None)
  for item in _pactl_json("source-outputs"):
    props = item.get("properties") or {}
    if props.get("target.object") == source_name:
      return True
    if index is not None and item.get("source") == index:
      return True
  return False


class HidSession:
  """Keeps hidraw open so GNP battery reports can arrive between polls."""

  def __init__(self) -> None:
    self.fd: int | None = None
    self.path = ""
    self.seq = 0
    self.dst = GNP_ADDRS[0]
    self.last_query = 0.0
    self.last_telephony = 0.0
    self.telephony_offhook = False

  def close(self) -> None:
    if self.fd is not None:
      try:
        os.close(self.fd)
      except OSError:
        pass
    self.fd = None
    self.path = ""

  def ensure(self) -> bool:
    info = hidraw_status()
    path = str(info.get("hidraw") or "")
    if info.get("hidAccess") != "ok" or not path:
      self.close()
      return False
    if self.fd is not None and self.path == path:
      return True
    self.close()
    try:
      self.fd = os.open(path, os.O_RDWR | os.O_NONBLOCK)
    except OSError:
      return False
    self.path = path
    return True

  def query(self) -> None:
    if not self.ensure() or self.fd is None:
      return
    self.seq = (self.seq + 1) & 0xFF
    try:
      os.write(self.fd, gnp_battery_request(self.dst, self.seq))
    except OSError:
      self.close()
      return
    self.last_query = _now()

  def read_available(self) -> dict | None:
    if self.fd is None:
      return None
    found = None
    while True:
      try:
        buf = os.read(self.fd, GNP_PACKET)
      except (BlockingIOError, OSError):
        break
      if not buf:
        break
      parsed = parse_gnp_battery(buf)
      if parsed:
        parsed["address"] = self.dst
        found = parsed
    return found

  def set_telephony(self, off_hook: bool, muted: bool = False, force: bool = False) -> bool:
    """Drive Off-Hook / Mute LEDs so the buds unmute for a capture stream."""
    if not self.ensure() or self.fd is None:
      return False
    now = _now()
    if (
      not force
      and self.telephony_offhook == bool(off_hook)
      and now - self.last_telephony < 0.2
    ):
      return True
    try:
      os.write(self.fd, telephony_report(off_hook, muted))
    except OSError:
      self.close()
      return False
    self.telephony_offhook = bool(off_hook)
    self.last_telephony = now
    if off_hook:
      boost_jabra_capture()
    return True


def cmd_watch() -> int:
  last_json = ""
  last_gesture = None
  last_battery = None
  ev_path = ""
  ev_dev = None
  hotkeys = []
  hid = HidSession()
  capturing = False
  next_capture = 0.0
  sub = None

  def reopen():
    nonlocal ev_path, ev_dev, hotkeys
    if ev_dev is not None:
      try:
        ev_dev.close()
      except OSError:
        pass
      ev_dev = None
    for dev in hotkeys:
      try:
        dev.close()
      except OSError:
        pass
    hotkeys = find_hotkey_devices()
    ev_path = find_evdev()
    if not ev_path:
      return
    try:
      from evdev import InputDevice
      ev_dev = InputDevice(ev_path)
    except OSError:
      ev_dev = None

  def reopen_subscribe():
    nonlocal sub
    if sub is not None:
      try:
        sub.kill()
      except OSError:
        pass
      sub = None
    import shutil
    import subprocess
    cmd = ["pactl", "subscribe"]
    if shutil.which("stdbuf"):
      cmd = ["stdbuf", "-oL", "pactl", "subscribe"]
    try:
      sub = subprocess.Popen(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        bufsize=1,
      )
    except OSError:
      sub = None

  def sync_telephony(scan: bool) -> None:
    nonlocal capturing, next_capture
    now = _now()
    if scan or now >= next_capture:
      pulse = pulse_status()
      capturing = jabra_capture_active(str(pulse.get("sourceName") or ""))
      next_capture = now + 1.5
      if capturing and pulse.get("sourceName") and pulse.get("micMuted"):
        _run(["pactl", "set-source-mute", str(pulse["sourceName"]), "0"])
    hid.set_telephony(capturing or voxtype_recording())

  reopen()
  reopen_subscribe()
  next_poll = 0.0
  next_addr = 0
  while True:
    now = _now()
    sync_telephony(False)
    if now >= next_poll:
      if hid.ensure() and (hid.last_query == 0.0 or now - hid.last_query >= 5.0):
        if last_battery is None:
          hid.dst = GNP_ADDRS[next_addr % len(GNP_ADDRS)]
          next_addr += 1
        hid.query()
        if hid.telephony_offhook:
          hid.set_telephony(True, force=True)
      probed = hid.read_available()
      if probed:
        last_battery = probed
        hid.dst = probed.get("address") or hid.dst
      snap = snapshot(last_gesture, last_battery)
      if not snap.get("connected"):
        last_battery = None
        snap["battery"] = None
      encoded = json.dumps(snap, separators=(",", ":"), sort_keys=True)
      if encoded != last_json:
        emit(snap)
        last_json = encoded
      next_poll = now + 1.5
      if ev_dev is None:
        reopen()

    fds = []
    if ev_dev is not None:
      fds.append(ev_dev.fd)
    for dev in hotkeys:
      fds.append(dev.fd)
    if hid.fd is not None:
      fds.append(hid.fd)
    if sub is not None and sub.stdout is not None:
      fds.append(sub.stdout.fileno())
    timeout = max(0.05, min(0.1, next_poll - _now()))
    try:
      ready, _w, _x = select.select(fds, [], [], timeout)
    except (OSError, ValueError):
      reopen()
      reopen_subscribe()
      hid.close()
      continue
    if sub is not None and (sub.poll() is not None):
      reopen_subscribe()
    if not ready:
      continue
    if sub is not None and sub.stdout is not None and sub.stdout.fileno() in ready:
      try:
        line = sub.stdout.readline()
      except OSError:
        line = ""
        reopen_subscribe()
      if "source-output" in line:
        sync_telephony(True)
    for dev in list(hotkeys):
      if dev.fd not in ready:
        continue
      try:
        from evdev import ecodes
        for event in dev.read():
          if event.type != ecodes.EV_KEY or event.value != 1:
            continue
          if event.code in (ecodes.KEY_RIGHTCTRL, ecodes.KEY_F9):
            hid.set_telephony(True, force=True)
      except OSError:
        reopen()
        break
    if hid.fd is not None and hid.fd in ready:
      probed = hid.read_available()
      if probed:
        last_battery = probed
        hid.dst = probed.get("address") or hid.dst
        snap = snapshot(last_gesture, last_battery)
        emit(snap)
        last_json = json.dumps(snap, separators=(",", ":"), sort_keys=True)
    if ev_dev is None or ev_dev.fd not in ready:
      continue
    try:
      from evdev import ecodes
      for event in ev_dev.read():
        if event.type != ecodes.EV_KEY:
          continue
        if event.value != 1:
          continue
        try:
          key = ecodes.KEY[event.code]
        except KeyError:
          key = f"KEY_{event.code}"
        if isinstance(key, list):
          key = key[0]
        last_gesture = {
          "key": key,
          "label": key_label(key),
          "ts": time.time(),
        }
        snap = snapshot(last_gesture, last_battery)
        emit(snap)
        last_json = json.dumps(snap, separators=(",", ":"), sort_keys=True)
        next_poll = _now() + 1.5
    except OSError:
      reopen()
      last_gesture = None
  return 0


def usage() -> None:
  sys.stderr.write(
    "Usage: jabra-ctl status|watch|set-default|mute|mic-mute|volume <up|down|N>|anc <mode>\n"
  )


def main(argv: list[str] | None = None) -> int:
  args = list(sys.argv[1:] if argv is None else argv)
  if not args or args[0] in ("-h", "--help"):
    usage()
    return 2
  cmd = args[0]
  if cmd == "status":
    return cmd_status()
  if cmd == "watch":
    return cmd_watch()
  if cmd in ("set-default", "default"):
    return cmd_set_default()
  if cmd == "mute":
    return cmd_mute("sink")
  if cmd in ("mic-mute", "micmute"):
    return cmd_mute("mic")
  if cmd == "volume":
    if len(args) < 2:
      usage()
      return 2
    return cmd_volume(args[1])
  if cmd == "anc":
    mode = args[1] if len(args) > 1 else "cycle"
    return cmd_anc(mode)
  usage()
  return 2


if __name__ == "__main__":
  try:
    sys.exit(main())
  except KeyboardInterrupt:
    sys.exit(130)
